# Required
POSTGRES_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-to-64-random-characters-change-me-to-64-random-characters
APP_URL=http://localhost:8080

# Global super admin (created on first start)
SUPERADMIN_EMAIL=ops@example.com
SUPERADMIN_PASSWORD=change-me-10plus-chars-1

# AI (column mapping, factor matching, assistant). Optional but recommended.
# LLM backend (assistant, column mapping, factor matching, embeddings): gemini | openai
LLM_PROVIDER=gemini
# Optional: override the provider's default chat model
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Any OpenAI-compatible server (Azure, OpenRouter, vLLM, Ollama…)
OPENAI_BASE_URL=https://api.openai.com/v1

# Email (verification, invites, new passwords). Any SMTP relay works.
# For local testing: start with `--profile mail` and set SMTP_HOST=mailpit, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Carbon Glint <no-reply@example.com>

# DEFRA conversion factor year to load on first start
DEFRA_YEAR=2026

# Host port for the web app
HTTP_PORT=8080

# Pin image versions (defaults to :latest)
# CARBON_GLINT_API_IMAGE=ghcr.io/britto-772004/carbon-glint-api:v0.1.0
# CARBON_GLINT_WEB_IMAGE=ghcr.io/britto-772004/carbon-glint-web:v0.1.0
