# Installed to /etc/caddy/Caddyfile on every deploy. TLS is terminated by Cloudflare Tunnel,
# so Caddy only listens on plain HTTP (localhost via the tunnel, or the VM IP if port 80 is opened).
{
	admin localhost:2019
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /opt/carbon-glint/current/web
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
