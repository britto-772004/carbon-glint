# Installed to /etc/caddy/Caddyfile on every deploy.
# :80 serves plain HTTP (localhost via the Cloudflare Tunnel, health checks, or the VM IP).
# When DOMAIN is set, deploy-release.sh appends a site block for it, and Caddy obtains and renews
# a Let's Encrypt certificate by itself (ports 80 and 443 must be open to the internet).
{
	admin localhost:2019
	servers {
		trusted_proxies static private_ranges
	}
}

(app) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /opt/carbon-glint/current/web
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

:80 {
	import app
}
