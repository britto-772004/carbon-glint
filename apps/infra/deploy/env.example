# Written to /opt/carbon-glint/shared/.env by GitHub Actions on each deploy (values come from GitHub secrets).
NODE_ENV=production
PORT=8080
APP_URL=https://your-tunnel-or-domain
APP_VERSION=<git sha>
LOG_LEVEL=info

POSTGRES_PASSWORD=<secret>
DATABASE_URL=postgres://carbon:<secret>@127.0.0.1:5432/carbon_glint
REDIS_URL=redis://127.0.0.1:6379

# LLM backend: gemini | openai (set the matching API key)
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=<secret>
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USER=<secret>
SMTP_PASS=<secret>
MAIL_FROM="Carbon Glint <no-reply@example.com>"

FILES_DIR=/opt/carbon-glint/shared/files

# Optional: stable hostname via a named Cloudflare Tunnel (otherwise a quick *.trycloudflare.com URL is used)
CLOUDFLARE_TUNNEL_TOKEN=
