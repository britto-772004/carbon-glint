NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# Local: docker compose Postgres. Deployed: Neon pooled connection string (…-pooler…/db?sslmode=require)
DATABASE_URL=postgres://carbon:carbon@localhost:5432/carbon_glint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only needed if the web app calls the API cross-origin (e.g. vite on :5173 without the proxy)
CORS_ORIGINS=
