NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
APP_URL=http://localhost:5173
# Local docker Postgres / Redis (pnpm db:up). On the VM these point at native localhost services.
DATABASE_URL=postgres://carbon:carbon@localhost:5432/carbon_glint
REDIS_URL=redis://127.0.0.1:6379
FILES_DIR=./.data/files
# Mailpit catches all mail locally: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Carbon Glint <no-reply@carbon-glint.local>
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=
