NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
APP_URL=http://localhost:5173
# Local docker Postgres / Redis (pnpm db:up). On the VM these point at native localhost services.
DATABASE_URL=postgres://carbon:carbon@localhost:5432/carbon_glint
REDIS_URL=redis://127.0.0.1:6379
FILES_DIR=./.data/files
# Mailpit catches all mail locally: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Carbon Glint <no-reply@carbon-glint.local>
# LLM backend (assistant, column mapping, factor matching, embeddings): gemini | openai
LLM_PROVIDER=gemini
# Optional: override the provider's default chat model
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Any OpenAI-compatible server (Azure, OpenRouter, vLLM, Ollama…)
OPENAI_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=
